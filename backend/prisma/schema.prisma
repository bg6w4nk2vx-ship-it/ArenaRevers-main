// Prisma Schema for ArenaReserve
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  OWNER
  ADMIN
}

enum ArenaStatus {
  active
  maintenance
  closed
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  completed
  rejected
  hold
}

enum PaymentStatus {
  unpaid
  partial
  paid
  refunded
}

enum PaymentProvider {
  stripe
  kaspi
  cash
}

enum PaymentType {
  full
  deposit
}

enum PaymentTransactionStatus {
  pending
  succeeded
  failed
  refunded
}

enum NotificationType {
  booking_confirmed
  booking_reminder
  booking_cancelled
  payment_received
  payment_failed
  booking_completed
  rating_received
}

enum NotificationChannel {
  email
  push
  telegram
}

model User {
  id            String    @id @default(uuid())
  fullName      String    @map("full_name")
  email         String    @unique
  phone         String?   @unique
  passwordHash  String?   @map("password_hash")
  role          UserRole  @default(USER)
  isVerified    Boolean   @default(false) @map("is_verified")
  isSuperAdmin  Boolean   @default(false) @map("is_super_admin")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  ownedArenas   Arena[]
  bookings      Booking[]
  payments      Payment[]
  ratings       Rating[]
  notifications Notification[]
  favorites     Favorite[]

  @@map("users")
}

model Arena {
  id            String       @id @default(uuid())
  ownerId       String       @map("owner_id")
  title         String
  description   String?
  sportType     String       @map("sport_type")
  address       String
  latitude      Decimal?
  longitude     Decimal?
  pricePerHour  Decimal      @map("price_per_hour")
  timezone      String       @default("Asia/Almaty")
  status        ArenaStatus  @default(active)
  technicalInfo Json?        @map("technical_info")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  // Relations
  owner         User         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  images        ArenaImage[]
  schedules     Schedule[]
  bookings      Booking[]
  ratings       Rating[]
  favorites     Favorite[]

  @@map("arenas")
}

model ArenaImage {
  id        String   @id @default(uuid())
  arenaId  String   @map("arena_id")
  url       String
  altText   String?  @map("alt_text")
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  arena     Arena    @relation(fields: [arenaId], references: [id], onDelete: Cascade)

  @@map("arena_images")
}

model Schedule {
  id             String   @id @default(uuid())
  arenaId        String   @map("arena_id")
  weekday        Int      // 0-6 (Sunday-Saturday)
  startTime      String   @map("start_time") // HH:mm format
  endTime        String   @map("end_time") // HH:mm format
  priceModifier  Decimal  @default(1.0) @map("price_modifier")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  arena          Arena    @relation(fields: [arenaId], references: [id], onDelete: Cascade)

  @@map("schedules")
}

model Booking {
  id                  String        @id @default(uuid())
  userId              String        @map("user_id")
  arenaId             String        @map("arena_id")
  startDatetime       DateTime      @map("start_datetime")
  endDatetime         DateTime      @map("end_datetime")
  status              BookingStatus @default(pending)
  totalAmount         Decimal?      @map("total_amount")
  paidAmount          Decimal       @default(0) @map("paid_amount")
  paymentStatus       PaymentStatus @default(unpaid) @map("payment_status")
  paymentMethod       String?       @map("payment_method")
  promoCode           String?       @map("promo_code")
  holdExpireAt        DateTime?     @map("hold_expire_at")
  adminMarkedCompleted Boolean      @default(false) @map("admin_marked_completed")
  adminNotes          String?       @map("admin_notes")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  // Relations
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  arena         Arena         @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  payments      Payment[]

  @@map("bookings")
}

model Payment {
  id                  String                 @id @default(uuid())
  bookingId           String                 @map("booking_id")
  userId              String                 @map("user_id")
  amount              Decimal
  currency            String                 @default("KZT")
  provider            PaymentProvider
  providerPaymentId   String?                @map("provider_payment_id")
  status              PaymentTransactionStatus @default(pending)
  type                PaymentType
  receiptUrl          String?                @map("receipt_url")
  metadata            Json?                  // Additional payment data
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")

  // Relations
  booking             Booking                @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Rating {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  arenaId   String   @map("arena_id")
  stars     Int      // 1-5
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  arena     Arena    @relation(fields: [arenaId], references: [id], onDelete: Cascade)

  @@unique([userId, arenaId])
  @@map("ratings")
}

model Notification {
  id        String            @id @default(uuid())
  userId    String            @map("user_id")
  type      NotificationType
  payload   Json
  isRead    Boolean           @default(false) @map("is_read")
  channel   NotificationChannel @default(email)
  createdAt DateTime          @default(now()) @map("created_at")

  // Relations
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Refund {
  id              String   @id @default(uuid())
  paymentId       String   @map("payment_id")
  amount          Decimal
  reason          String?
  status          String   @default("pending") // pending, processed, failed
  providerRefundId String? @map("provider_refund_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("refunds")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  resource  String
  resourceId String? @map("resource_id")
  details   Json?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  arenaId   String   @map("arena_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  arena     Arena    @relation(fields: [arenaId], references: [id], onDelete: Cascade)

  @@unique([userId, arenaId])
  @@map("favorites")
}

