pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  parameters {
    choice(name: 'TERRAFORM_LAB', choices: ['lab-00', 'lab-01', 'lab-02', 'lab-03', 'lab-04', 'lab-05'], description: 'Terraform lab directory under terraform/')
    choice(name: 'TF_ACTION', choices: ['plan', 'apply', 'destroy'], description: 'Terraform action')
    booleanParam(name: 'RUN_ANSIBLE', defaultValue: false, description: 'Run Ansible checks/deploy after Terraform stage')
    choice(name: 'ANSIBLE_ACTION', choices: ['syntax', 'tasks', 'inventory', 'deploy'], description: 'Ansible action from ansible-docker.ps1')
    string(name: 'AWS_ACCESS_KEY_ID_CRED', defaultValue: '', description: 'Jenkins credential ID for AWS access key id (optional)')
    string(name: 'AWS_SECRET_ACCESS_KEY_CRED', defaultValue: '', description: 'Jenkins credential ID for AWS secret access key (optional)')
    string(name: 'AWS_SESSION_TOKEN_CRED', defaultValue: '', description: 'Jenkins credential ID for AWS session token (optional)')
  }

  environment {
    TF_IN_AUTOMATION = 'true'
    TF_INPUT = '0'
    AWS_DEFAULT_REGION = 'eu-north-1'
    AWS_EC2_METADATA_DISABLED = 'true'
    TERRAFORM_VERSION = '1.8.5'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Terraform Init') {
      steps {
        dir("terraform/${params.TERRAFORM_LAB}") {
          script {
            def awsCreds = []
            if (params.AWS_ACCESS_KEY_ID_CRED?.trim() && !params.AWS_SECRET_ACCESS_KEY_CRED?.trim()) {
              error('AWS_ACCESS_KEY_ID_CRED is set but AWS_SECRET_ACCESS_KEY_CRED is empty. Set both credential IDs.')
            }
            if (!params.AWS_ACCESS_KEY_ID_CRED?.trim() && params.AWS_SECRET_ACCESS_KEY_CRED?.trim()) {
              error('AWS_SECRET_ACCESS_KEY_CRED is set but AWS_ACCESS_KEY_ID_CRED is empty. Set both credential IDs.')
            }
            if (params.AWS_ACCESS_KEY_ID_CRED?.trim()) {
              awsCreds << string(credentialsId: params.AWS_ACCESS_KEY_ID_CRED, variable: 'AWS_ACCESS_KEY_ID')
            }
            if (params.AWS_SECRET_ACCESS_KEY_CRED?.trim()) {
              awsCreds << string(credentialsId: params.AWS_SECRET_ACCESS_KEY_CRED, variable: 'AWS_SECRET_ACCESS_KEY')
            }
            if (params.AWS_SESSION_TOKEN_CRED?.trim()) {
              awsCreds << string(credentialsId: params.AWS_SESSION_TOKEN_CRED, variable: 'AWS_SESSION_TOKEN')
            }

            def initScript = '''
              set -e
              if [ ! -x "${WORKSPACE}/.terraform-bin/terraform" ]; then
                os=$(uname | tr '[:upper:]' '[:lower:]')
                arch=$(uname -m)
                case "$arch" in
                  x86_64) arch=amd64 ;;
                  aarch64|arm64) arch=arm64 ;;
                  *) echo "Unsupported architecture: $arch" ; exit 1 ;;
                esac

                mkdir -p "${WORKSPACE}/.terraform-bin"
                if command -v curl >/dev/null 2>&1; then
                  curl -L -o "${WORKSPACE}/terraform.zip" "https://releases.hashicorp.com/terraform/${TERRAFORM_VERSION}/terraform_${TERRAFORM_VERSION}_${os}_${arch}.zip"
                elif command -v wget >/dev/null 2>&1; then
                  wget -O "${WORKSPACE}/terraform.zip" "https://releases.hashicorp.com/terraform/${TERRAFORM_VERSION}/terraform_${TERRAFORM_VERSION}_${os}_${arch}.zip"
                else
                  echo "Need curl or wget to install Terraform"
                  exit 1
                fi
                if [ ! -f "${WORKSPACE}/terraform.zip" ] || [ ! -s "${WORKSPACE}/terraform.zip" ]; then
                  echo "Terraform archive download failed"
                  ls -l "${WORKSPACE}/terraform.zip" || true
                  cat "${WORKSPACE}/terraform.zip" | head -n 20 || true
                  exit 1
                fi
                unzip -o "${WORKSPACE}/terraform.zip" -d "${WORKSPACE}/.terraform-bin"
                rm -f "${WORKSPACE}/terraform.zip"
              fi
              export PATH="${WORKSPACE}/.terraform-bin:$PATH"
              terraform init -input=false
            '''

            if (awsCreds) {
              withCredentials(awsCreds) {
                sh initScript
              }
            } else {
              sh initScript
            }
          }
        }
      }
    }

    stage('Terraform Plan') {
      when {
        expression { params.TF_ACTION == 'plan' || params.TF_ACTION == 'apply' || params.TF_ACTION == 'destroy' }
      }
      steps {
        dir("terraform/${params.TERRAFORM_LAB}") {
          script {
            def awsCreds = []
            if (params.AWS_ACCESS_KEY_ID_CRED?.trim()) {
              awsCreds << string(credentialsId: params.AWS_ACCESS_KEY_ID_CRED, variable: 'AWS_ACCESS_KEY_ID')
            }
            if (params.AWS_SECRET_ACCESS_KEY_CRED?.trim()) {
              awsCreds << string(credentialsId: params.AWS_SECRET_ACCESS_KEY_CRED, variable: 'AWS_SECRET_ACCESS_KEY')
            }
            if (params.AWS_SESSION_TOKEN_CRED?.trim()) {
              awsCreds << string(credentialsId: params.AWS_SESSION_TOKEN_CRED, variable: 'AWS_SESSION_TOKEN')
            }

            def planScript = '''
              set -e
              export PATH="${WORKSPACE}/.terraform-bin:$PATH"
              if [ -z "${AWS_ACCESS_KEY_ID:-}" ] || [ -z "${AWS_SECRET_ACCESS_KEY:-}" ]; then
                echo "ERROR: AWS credentials are not available for Terraform plan."
                echo "Provide Jenkins credential IDs in parameters AWS_ACCESS_KEY_ID_CRED and AWS_SECRET_ACCESS_KEY_CRED"
                echo "or configure credentials on Jenkins agent (IAM role / environment)."
                exit 2
              fi
              echo "AWS credentials detected for Terraform plan."
              if command -v aws >/dev/null 2>&1; then
                aws sts get-caller-identity >/dev/null
                echo "AWS STS identity check passed."
              else
                echo "AWS CLI not found, skipping STS identity check."
              fi
              terraform plan -out=tfplan
            '''

            if (awsCreds) {
              withCredentials(awsCreds) {
                sh planScript
              }
            } else {
              sh planScript
            }
          }
        }
      }
    }

    stage('Terraform Apply/Destroy') {
      when {
        expression { params.TF_ACTION == 'apply' || params.TF_ACTION == 'destroy' }
      }
      steps {
        input message: "Approve ${params.TF_ACTION} for ${params.TERRAFORM_LAB}?", ok: 'Proceed'
        dir("terraform/${params.TERRAFORM_LAB}") {
          script {
            def awsCreds = []
            if (params.AWS_ACCESS_KEY_ID_CRED?.trim() && !params.AWS_SECRET_ACCESS_KEY_CRED?.trim()) {
              error('AWS_ACCESS_KEY_ID_CRED is set but AWS_SECRET_ACCESS_KEY_CRED is empty. Set both credential IDs.')
            }
            if (!params.AWS_ACCESS_KEY_ID_CRED?.trim() && params.AWS_SECRET_ACCESS_KEY_CRED?.trim()) {
              error('AWS_SECRET_ACCESS_KEY_CRED is set but AWS_ACCESS_KEY_ID_CRED is empty. Set both credential IDs.')
            }
            if (params.AWS_ACCESS_KEY_ID_CRED?.trim()) {
              awsCreds << string(credentialsId: params.AWS_ACCESS_KEY_ID_CRED, variable: 'AWS_ACCESS_KEY_ID')
            }
            if (params.AWS_SECRET_ACCESS_KEY_CRED?.trim()) {
              awsCreds << string(credentialsId: params.AWS_SECRET_ACCESS_KEY_CRED, variable: 'AWS_SECRET_ACCESS_KEY')
            }
            if (params.AWS_SESSION_TOKEN_CRED?.trim()) {
              awsCreds << string(credentialsId: params.AWS_SESSION_TOKEN_CRED, variable: 'AWS_SESSION_TOKEN')
            }

            def applyScript = '''
              set -e
              export PATH="${WORKSPACE}/.terraform-bin:$PATH"
              if [ -z "${AWS_ACCESS_KEY_ID:-}" ] || [ -z "${AWS_SECRET_ACCESS_KEY:-}" ]; then
                echo "ERROR: AWS credentials are not available for Terraform apply."
                echo "Provide Jenkins credential IDs in parameters AWS_ACCESS_KEY_ID_CRED and AWS_SECRET_ACCESS_KEY_CRED"
                echo "or configure credentials on Jenkins agent (IAM role / environment)."
                exit 2
              fi
              echo "AWS credentials detected for Terraform apply."
              if command -v aws >/dev/null 2>&1; then
                aws sts get-caller-identity >/dev/null
                echo "AWS STS identity check passed."
              else
                echo "AWS CLI not found, skipping STS identity check."
              fi
              terraform apply -auto-approve tfplan
            '''
            def destroyScript = '''
              set -e
              export PATH="${WORKSPACE}/.terraform-bin:$PATH"
              if [ -z "${AWS_ACCESS_KEY_ID:-}" ] || [ -z "${AWS_SECRET_ACCESS_KEY:-}" ]; then
                echo "ERROR: AWS credentials are not available for Terraform destroy."
                echo "Provide Jenkins credential IDs in parameters AWS_ACCESS_KEY_ID_CRED and AWS_SECRET_ACCESS_KEY_CRED"
                echo "or configure credentials on Jenkins agent (IAM role / environment)."
                exit 2
              fi
              echo "AWS credentials detected for Terraform destroy."
              if command -v aws >/dev/null 2>&1; then
                aws sts get-caller-identity >/dev/null
                echo "AWS STS identity check passed."
              else
                echo "AWS CLI not found, skipping STS identity check."
              fi
              terraform destroy -auto-approve
            '''

            if (awsCreds) {
              withCredentials(awsCreds) {
                if (params.TF_ACTION == 'destroy') {
                  sh destroyScript
                } else {
                  sh applyScript
                }
              }
            } else {
              if (params.TF_ACTION == 'destroy') {
                sh destroyScript
              } else {
                sh applyScript
              }
            }
          }
        }
      }
    }

    stage('Ansible') {
      when {
        expression { params.RUN_ANSIBLE }
      }
      steps {
        sh '''
          set -e
          case "${ANSIBLE_ACTION}" in
            syntax)
              docker run --rm -v "$(pwd):/work" -w /work/ansible -e ANSIBLE_CONFIG=/work/ansible/ansible.cfg \
                cytopia/ansible:latest ansible-playbook -i inventories/dev/hosts.yml playbooks/deploy.yml --syntax-check
              ;;
            tasks)
              docker run --rm -v "$(pwd):/work" -w /work/ansible -e ANSIBLE_CONFIG=/work/ansible/ansible.cfg \
                cytopia/ansible:latest ansible-playbook -i inventories/dev/hosts.yml playbooks/deploy.yml --list-tasks
              ;;
            inventory)
              docker run --rm -v "$(pwd):/work" -w /work/ansible -e ANSIBLE_CONFIG=/work/ansible/ansible.cfg \
                cytopia/ansible:latest ansible-inventory -i inventories/dev/hosts.yml --graph
              ;;
            deploy)
              docker run --rm -v "$(pwd):/work" -w /work/ansible -e ANSIBLE_CONFIG=/work/ansible/ansible.cfg \
                cytopia/ansible:latest ansible-playbook -i inventories/dev/hosts.yml playbooks/deploy.yml
              ;;
            *)
              echo "Unsupported ANSIBLE_ACTION: ${ANSIBLE_ACTION}"
              exit 1
              ;;
          esac
        '''
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: 'terraform/**/tfplan, terraform/**/.terraform.lock.hcl', allowEmptyArchive: true
    }
  }
}
