# Root ignores for monorepo

# Dependency folders
node_modules/
backend/node_modules/
frontend/node_modules/

# Lockfiles generated per package manager
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build and cache
dist/
build/
.vite/
coverage/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
terraform.tfvars
terraform.tfvars.json

# Runtime output
logs/
*.log

# Environment secrets
.env
.env.*
!.env.example

# Uploads and generated assets
backend/public/uploads/
backend/uploads/

# OS and IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
